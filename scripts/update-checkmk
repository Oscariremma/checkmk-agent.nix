#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."
nix-update --flake checkmk-agent --subpackage cmk-agent-ctl \
  --version-regex '^v?([0-9]+\.[0-9]+\.[0-9]+(?:p[0-9]+)?)$' "$@"
nixfmt package.nix
version=$(nix eval --raw .#checkmk-agent.version)
sed -i "s|https://img\.shields\.io/badge/CheckMK-[^-]*-|https://img.shields.io/badge/CheckMK-${version}-|" README.md
